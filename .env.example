# GuardRAIL local configuration template. Copy to .env and replace every CHANGE_ME.
# Never commit .env or use these values for production.

# PostgreSQL
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=guardrail
DATABASE_URL=postgresql+psycopg://CHANGE_ME:CHANGE_ME@postgres:5432/guardrail

# JWT / signing
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_VALUE
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
GRANT_HMAC_SECRET=CHANGE_ME_GENERATE_A_RANDOM_VALUE
POLICY_VERSION=1.0.0

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MailHog
MAILHOG_SMTP_HOST=mailhog
MAILHOG_SMTP_PORT=1025
MAILHOG_API_URL=http://mailhog:8025

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=finance-internal
MINIO_SECURE=false

# GitHub Issues (fine-grained token: Issues R/W + Metadata R only)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_ENABLED=false

# Local synthetic demo accounts only. Set unique passwords before starting.
DEMO_EMPLOYEE_PASSWORD=CHANGE_ME
DEMO_MANAGER_PASSWORD=CHANGE_ME
DEMO_FINANCE_PASSWORD=CHANGE_ME
DEMO_SECURITY_PASSWORD=CHANGE_ME

# LLM
LLM_PROVIDER=mock

# App
APP_ENV=development
API_RATE_LIMIT=120/minute
SEED_ON_STARTUP=true
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
